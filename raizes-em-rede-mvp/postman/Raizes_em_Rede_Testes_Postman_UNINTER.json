        {
          "name": "T07 POSITIVO — Criar pedido aprovado",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"uniqueKey\",\"uninter-\"+Date.now()+\"-\"+Math.random().toString(36).slice(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Pagamento aprovado\",()=>pm.expect(pm.response.json().pedido.pagamentoStatus).to.eql(\"APROVADO\"));",
                  "if(pm.response.code===201) pm.collectionVariables.set(\"orderCode\",pm.response.json().pedido.codigo);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{uniqueKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unidadeId\": {{unitId}},\n  \"canalPedido\": \"SITE\",\n  \"itens\": [\n    {\n      \"produtoId\": {{productId}},\n      \"quantidade\": 1\n    }\n  ],\n  \"resultadoPagamento\": \"APROVADO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            }
          },
          "response": []
        },
